# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────

# Your Supabase project URL — Supabase dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key — Supabase dashboard → Settings → API → anon key
# Safe to expose in the browser (RLS enforces data access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — Supabase dashboard → Settings → API → service_role key
# NEVER expose this in the browser. Used by the server-side admin client to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
# Resend (email delivery)
# ─────────────────────────────────────────────

# Resend API key — resend.com → API Keys → Create API Key
# Used to send onboarding, client invite, and remark notification emails.
# Production delivery requires a domain verified in Resend; set EMAIL_FROM_ADDRESS
# to an address on that domain. Without it Resend's sandbox sender is used.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# ─────────────────────────────────────────────
# OpenAI (reserved for the planned AI agent)
# ─────────────────────────────────────────────

# NOT used by the application yet — keep it set in Vercel for the upcoming AI work.
# platform.openai.com → API Keys
OPENAI_API_KEY=

# ─────────────────────────────────────────────
# Encryption
# ─────────────────────────────────────────────

# A strong random secret string used to encrypt Instantly API keys at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypting or decrypting a key throws if this is missing or left as the default placeholder.
# NEVER commit the real value; rotate all stored API keys if this key ever leaks.
ENCRYPTION_KEY=

# ─────────────────────────────────────────────
# Cron
# ─────────────────────────────────────────────

# REQUIRED for the scheduled Instantly sync. GET /api/sync-instantly returns 503
# (and does nothing) when this is unset, and 401 unless the request carries
# `Authorization: Bearer <CRON_SECRET>`. Vercel Cron sends that header
# automatically when CRON_SECRET is set in the project's environment variables
# (see vercel.json: one run per day on the Hobby plan).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ─────────────────────────────────────────────
# Landing page (public site at "/")
# ─────────────────────────────────────────────

# Waitlist form: your Tally share link (https://tally.so/r/XXXX). Optional: when empty,
# the landing page falls back to a mailto link.
NEXT_PUBLIC_TALLY_FORM_URL=

# Public site URL, used for metadata, robots and sitemap. Optional on Vercel (falls back to the production URL).
NEXT_PUBLIC_SITE_URL=
